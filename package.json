{
  "name": "dsh-completion-sound",
  "version": "1.2.0",
  "description": "DSH 完成任务音效：每轮对话完成时播放提示音，内置 7 种音效，支持音量、前台/后台播放、屏蔽其他提示音与自定义音频。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sound",
    "notification",
    "web-ui"
  ],
  "type": "module",
  "main": "index.js",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js",
    "dry-run": "npm pack --dry-run"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/huanyuan6657-cmd/dsh-completion-sound.git"
  },
  "homepage": "https://github.com/huanyuan6657-cmd/dsh-completion-sound#readme",
  "bugs": {
    "url": "https://github.com/huanyuan6657-cmd/dsh-completion-sound/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}